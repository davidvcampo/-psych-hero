rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can read a resource file (needed to preview/download from the
    // catalog). A signed-in user can only upload into their own folder, and
    // only files under 25MB.
    match /resources/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
